[GENERAL]
# solvation name (ex: ION)
name = ANTO
info = Acetonitrile 20%% mixture in OPC water
# path to off file
objectfile = ANTOPC20.off
# Name of the solvation box  unit in object file(ex: IONWAT20)
boxunit = ANTOPC20
watermodel = OPC

[PROBES]
# map probe names with residue@atoms (ie. NEG=COO@O1,O2)
# probe names must be unique
WAT=WAT@O
N=ANT@N1
C=ANT@C3

[TYPES]
WAT=Wat
N=Acc
C=Hyd

