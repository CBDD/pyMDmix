[GENERAL]
# solvation name (ex: ION)
name = MAMO
info = Acetamide 20%% mixture in OPC water
# path to off file
objectfile = MAMOPC20.off
# Name of the solvation box  unit in object file(ex: IONWAT20)
boxunit = MAMOPC20
watermodel = OPC

[PROBES]
# map probe names with residue@atoms (ie. NEG=COO@O1,O2)
# probe names must be unique
WAT=WAT@O
N=MAM@N1
O=MAM@O1
CT=MAM@C2

[TYPES]
WAT=Wat
N=Don
O=Acc
CT=Hyd

