[GENERAL]
# solvation name (ex: ION)
name = ISOO
info = Isopropanol 20%% mixture in OPC water
# path to off file
objectfile = ISOOPC20.off
# Name of the solvation box  unit in object file(ex: IONWAT20)
boxunit = ISOOPC20
watermodel = OPC

[PROBES]
# map probe names with residue@atoms (ie. NEG=COO@O1,O2)
# probe names must be unique
WAT=WAT@O
OH=ISO@O1
CT=ISO@C1,C3

[TYPES]
WAT=Wat
OH=Don,Acc
CT=Hyd

