[GENERAL]
# solvation name (ex: ION)
name = IONO
info = Ammonium Acetate mixture (Charged mixture) in OPC water
# path to off file
objectfile = IONOPC20.off
# Name of the solvation box  unit in object file(ex: IONWAT20)
boxunit = IONOPC20
watermodel = OPC

[PROBES]
# map probe names with residue@atoms (ie. NEG=COO@O1,O2)
# probe names must be unique
WAT=WAT@O
NEG=COO@O1,O2
POS=CN3@N1

[TYPES]
WAT=Wat
NEG=Neg
POS=Pos
