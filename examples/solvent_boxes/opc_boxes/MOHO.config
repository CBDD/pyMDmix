[GENERAL]
# solvation name (ex: ION)
name = MOHO
info = Methanol 20%% mixture in OPC water
# path to off file
objectfile = MOHOPC20.off
# Name of the solvation box  unit in object file(ex: IONWAT20)
boxunit = MOHOPC20
watermodel = OPC

[PROBES]
# map probe names with residue@atoms (ie. NEG=COO@O1,O2)
# probe names must be unique
WAT=WAT@O
OH=MOH@O1
CT=MOH@C1

[TYPES]
WAT=Wat
OH=Don,Acc
CT=Hyd
